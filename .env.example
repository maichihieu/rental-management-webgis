# Environment: development / production
ENVIRONMENT=development

# Database
# PostgreSQL:
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/webgis_db
# SQLite local:
# DATABASE_URL=sqlite:///./webgis.db

# JWT
SECRET_KEY="YOUR SECRET_KEY"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server
HOST=127.0.0.1
PORT=8000